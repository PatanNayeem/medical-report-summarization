# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me
FLASK_DEBUG=False

# MongoDB is optional: if it is not running, the app uses SQLite automatically
MONGO_URI=mongodb://localhost:27017/medical_summarizer_db

# HuggingFace: leave the token empty to run in rule-based mode (no LLM)
HUGGINGFACE_API_TOKEN=
MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
